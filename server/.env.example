# Cópialo como .env junto a docker-compose.yml y ajústalo (en el NAS: id tu_usuario / getent group videodriver)
PUID=1026
PGID=100
VIDEO_GID=937
# grupo que da acceso a las carpetas compartidas en sus ACL (101 = administrators; mejor uno propio de solo lectura)
SHARE_GID=101
MEDIA_DIR=/volume1/Multimedia
# Grupos de DSM (Panel de control > Grupo) que dan acceso a CineLocal: sus miembros son administradores o usuarios.
# En cuanto exista uno de los dos, ADMINS y USERS dejan de usarse y quien no esté en ninguno no entra.
ADMIN_GROUP=cinelocal-admin
USER_GROUP=cinelocal-user
# sin grupos creados: administradores, y usuarios permitidos (vacío = cualquier usuario de DSM)
ADMINS=tu_usuario
USERS=
# 0.0.0.0 = accesible en el puerto 8095 desde la red y la VPN; 127.0.0.1 = sólo a través del proxy inverso de DSM
BIND_HOST=0.0.0.0
