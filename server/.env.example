# Cópialo como .env junto a docker-compose.yml y ajústalo (en el NAS: id danthalion / getent group videodriver)
PUID=1026
PGID=100
VIDEO_GID=937
# grupo que da acceso a las carpetas compartidas en sus ACL (101 = administrators; mejor uno propio de solo lectura)
SHARE_GID=101
MEDIA_DIR=/volume1/Multimedia
ADMINS=danthalion
# vacío = cualquier usuario de DSM; si no, sólo estos (separados por comas)
USERS=
# 0.0.0.0 = accesible en el puerto 8095 desde la red y la VPN; 127.0.0.1 = sólo a través del proxy inverso de DSM
BIND_HOST=0.0.0.0
