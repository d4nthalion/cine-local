<-- Plantilla del servidor web de eMule para CineLocal.                     -->
<-- Devuelve los datos como lineas "clave<TAB>valor" en lugar de HTML para  -->
<-- que CineLocal los lea sin depender del formato de la interfaz web.       -->

<--TMPL_VERSION-->
7
<--TMPL_VERSION_END-->

<--TMPL_LOGIN-->
#LOGIN
<--TMPL_LOGIN_END-->

<--TMPL_HEADER-->
#HEADER
tmpl	2
ses	[Session]
con	[ConState]
context	[ConText]
kad	[KadConText]
down	[CurDownload]
up	[CurUpload]
#/HEADER
<--TMPL_HEADER_END-->

<--TMPL_HEADER_STYLESHEET-->
<--TMPL_HEADER_STYLESHEET_END-->

<--TMPL_FOOTER-->
#FOOTER
<--TMPL_FOOTER_END-->

<--TMPL_TRANSFER_LIST-->
#TRANSFERS
[DownloadFilesList]
#/TRANSFERS
<--TMPL_TRANSFER_LIST_END-->

<--TMPL_TRANSFER_DOWN_HEADER-->
<--TMPL_TRANSFER_DOWN_HEADER_END-->

<--TMPL_TRANSFER_DOWN_FOOTER-->
<--TMPL_TRANSFER_DOWN_FOOTER_END-->

<--TMPL_TRANSFER_DOWN_LINE-->
#D
state	[DownState]
hash	[filehash]
name	[fname]
size	[2]
done	[3]
speed	[4]
sources	[5]
prio	[down-priority]
ed2k	[ed2k]
info	[finfo]
#/D
<--TMPL_TRANSFER_DOWN_LINE_END-->

<--TMPL_SEARCH-->
#SEARCH
msg	[Message]
[RESULTLIST]
#/SEARCH
<--TMPL_SEARCH_END-->

<--TMPL_SEARCH_RESULT_HEADER-->
<--TMPL_SEARCH_RESULT_HEADER_END-->

<--TMPL_SEARCH_RESULT_LINE-->
#R
s1	%s
s2	%s
s3	%s
s4	%s
s5	%s
s6	%s
s7	%s
s8	%s
s9	%s
#/R
<--TMPL_SEARCH_RESULT_LINE_END-->

<-- Revision 2 de la plantilla: lista de servidores y estado de Kad.        -->
<-- "tmpl" en la cabecera dice a CineLocal que eMule ya la ha recargado.     -->

<--TMPL_SERVER_LIST-->
#SERVERS
[AddServerBox]
[ServersList]
#/SERVERS
<--TMPL_SERVER_LIST_END-->

<--TMPL_SERVER_LINE-->
#S
name	[Servername]
ip	[ip]
port	[port]
desc	[Description]
ping	[Ping]
users	[Users]
files	[Files]
failed	[Failed]
prio	[server-priority]
type	[ServerType]
state	[ServerState]
version	[Version]
#/S
<--TMPL_SERVER_LINE_END-->

<--TMPL_ADDSERVERBOX-->
#SRVMSG
msg	[Message]
#/SRVMSG
<--TMPL_ADDSERVERBOX_END-->

<--TMPL_KADDLG-->
#KAD
status	[KADSTATUS]
stats	[KADSTATSDATA]
bootstrap	[BOOTSTRAPLINE]
#/KAD
<--TMPL_KADDLG_END-->

<--TMPL_BOOTSTRAPLINE-->
yes
<--TMPL_BOOTSTRAPLINE_END-->
